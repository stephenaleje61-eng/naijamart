# Supabase Configuration for ZangaMarket Direct Client
# In Netlify Site Settings > Environment Variables, set these two variables:
# VITE_SUPABASE_URL=https://your-project-id.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-public-key

VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Paystack Payment Gateway (Server-Side Secret Key - NEVER expose with VITE_ prefix)
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# Flutterwave Payment Gateway (Server-Side Keys - NEVER expose with VITE_ prefix)
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_WEBHOOK_HASH=""

# JWT / CEO Session Signing Secret (Server-Side only)
JWT_SECRET=""

# Optional Firebase Admin SDK credentials for cryptographic ID token & custom claim verification
# Set either FIREBASE_SERVICE_ACCOUNT_KEY (raw JSON or base64 JSON) or GOOGLE_APPLICATION_CREDENTIALS (path)
FIREBASE_SERVICE_ACCOUNT_KEY=""
GOOGLE_APPLICATION_CREDENTIALS=""
