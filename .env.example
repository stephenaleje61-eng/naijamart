# Supabase Configuration for ZangaMarket Direct Client
# In Netlify Site Settings > Environment Variables, set these two variables:
# VITE_SUPABASE_URL=https://your-project-id.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-public-key

VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"
