rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'stephenaleje61@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'sellerId', 'title', 'price', 'categoryId', 'images', 'status']) &&
        data.id is string && data.id.size() <= 128 &&
        data.sellerId is string && data.sellerId.size() <= 128 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        data.price is number && data.price > 0 &&
        data.categoryId is string && data.categoryId.size() <= 100 &&
        data.images is list && data.images.size() > 0 && data.images.size() <= 10 &&
        data.status is string;
    }

    // Products: public buyers can read listings; owners/admins manage
    match /products/{productId} {
      allow read: if true;

      allow create: if isValidProduct(request.resource.data) &&
        (!isSignedIn() || request.resource.data.sellerId == request.auth.uid || isAdmin());

      allow update: if isValidProduct(request.resource.data) &&
        (!isSignedIn() || resource.data.sellerId == request.auth.uid || isAdmin());

      allow delete: if !isSignedIn() || resource.data.sellerId == request.auth.uid || isAdmin();
    }

    // Categories: publicly readable
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Seller storefront profiles
    match /sellerProfiles/{sellerId} {
      allow read: if true;
      allow write: if true;
    }

    // Admins collection
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // Reports collection
    match /reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Wukari Bike Riders (Okada Directory)
    match /bikeRiders/{riderId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin() || true;
    }

    // What Students Need (Student Requests)
    match /studentRequests/{requestId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['id', 'title', 'budget', 'location', 'phone', 'userId', 'status']) &&
        request.resource.data.title is string && request.resource.data.title.size() > 0 &&
        request.resource.data.budget is number && request.resource.data.budget >= 0;
      allow update, delete: if true;
    }

    // Orders & Cart Review Persistence
    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasAll(['id', 'buyerId', 'buyerName', 'buyerPhone', 'items', 'totalAmount', 'status']) &&
        request.resource.data.items is list && request.resource.data.items.size() > 0;
      allow read, update: if true;
      allow delete: if isAdmin();
    }

    // SINGLE HUB - FUWukari (Open Campus Group Chat)
    match /hubMessages/{messageId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['senderId', 'senderName', 'createdAt']);
      allow update, delete: if isAdmin();
    }

    match /hubActiveUsers/{userId} {
      allow read, write: if true;
    }

    // FRIEND SYSTEM & DIRECT 1-ON-1 PRIVATE CHAT
    match /friendRequests/{requestId} {
      allow read, create, update, delete: if true;
    }

    match /friends/{friendId} {
      allow read, create, update, delete: if true;
    }

    match /privateChats/{chatId} {
      allow read, write: if true;

      match /messages/{msgId} {
        allow read, write: if true;
      }
    }

    // WUKARI AGENT (Lodges, Self-Contains & Roommate Finder)
    match /hux/{huxId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['title', 'location', 'price', 'category', 'type', 'phone', 'userId']);
      allow update, delete: if true;
    }

    // Scam and fraud reports on housing listings
    match /huxReports/{reportId} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
