rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource != null &&
        request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
    }

    function isUnder5MB() {
      return request.resource != null &&
        request.resource.size > 0 &&
        request.resource.size <= 5 * 1024 * 1024;
    }

    function isUnder10MB() {
      return request.resource != null &&
        request.resource.size > 0 &&
        request.resource.size <= 10 * 1024 * 1024;
    }

    function isChatAudioOrDocument() {
      return request.resource != null &&
        request.resource.size > 0 &&
        request.resource.size <= 10 * 1024 * 1024 && (
          request.resource.contentType.matches('audio/.*') ||
          request.resource.contentType == 'application/pdf' ||
          request.resource.contentType == 'application/msword' ||
          request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document' ||
          request.resource.contentType == 'text/plain'
        );
    }

    // Products: public buyers read product photos; authenticated guests or sellers upload to own folder
    match /products/{sellerId}/{fileName} {
      allow read: if true;
      allow create, update: if isSignedIn() && request.auth.uid == sellerId && isImage() && isUnder5MB();
      allow delete: if isSignedIn() && request.auth.uid == sellerId;
    }

    // Okada Riders: photos uploaded to riders/{userId}/{fileName}
    match /riders/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isSignedIn() && request.auth.uid == userId && isImage() && isUnder5MB();
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // BikeRiders alternate path
    match /bikeRiders/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isSignedIn() && request.auth.uid == userId && isImage() && isUnder5MB();
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Hub chat attachments (images, audio, docs)
    match /hub_chats/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isSignedIn() && request.auth.uid == userId && ((isImage() && isUnder5MB()) || isChatAudioOrDocument()) && isUnder10MB();
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Direct 1-on-1 private chat attachments (images, voice notes, documents)
    match /chat_attachments/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId && ((isImage() && isUnder5MB()) || isChatAudioOrDocument()) && isUnder10MB();
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Hux housing photos
    match /hux/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isSignedIn() && request.auth.uid == userId && isImage() && isUnder5MB();
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Student request photos
    match /requests/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isSignedIn() && request.auth.uid == userId && isImage() && isUnder5MB();
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // CEO Events posters
    match /events/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isSignedIn() && request.auth.uid == userId && isImage() && isUnder5MB();
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // FU SPORT UPDATE photos & posters
    match /sport_updates/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isSignedIn() && request.auth.uid == userId && isImage() && isUnder5MB();
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email == 'stephenaleje61@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    // FU GENERAL ANNOUNCEMENTS photos & posters
    match /general_announcements/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isSignedIn() && request.auth.uid == userId && isImage() && isUnder5MB();
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    // FU MARKET ADS banners & images (CEO-ONLY publishing & storage uploads)
    match /advertisements/{ownerId}/{fileName} {
      allow read: if true;
      allow create, update: if isCeo() && isImage() && isUnder5MB();
      allow delete: if isCeo();
    }

    // FU MARKET ADS business logos (CEO-ONLY)
    match /ad_logos/{ownerId}/{fileName} {
      allow read: if true;
      allow create, update: if isCeo() && isImage() && isUnder5MB();
      allow delete: if isCeo();
    }

    // Public Advertising Request attachments (uploaded by advertisers/students requesting ads)
    match /ad_requests/{ownerId}/{fileName} {
      allow read: if true;
      allow create, update: if isImage() && isUnder5MB() && (!isSignedIn() || request.auth.uid == ownerId || isAdmin());
      allow delete: if isAdmin() || isCeo() || (isSignedIn() && request.auth.uid == ownerId);
    }

    // FU MARKET STUDENT SERVICES photos
    match /services/{ownerId}/{fileName} {
      allow read: if true;
      allow create, update: if isImage() && isUnder5MB() && (!isSignedIn() || request.auth.uid == ownerId || isAdmin());
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == ownerId);
    }

    // CAMPUS EMERGENCY REPORT evidence (confidential: admin + uploader only)
    match /emergency_reports/{ownerId}/{fileName} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == ownerId);
      allow create, update: if isImage() && isUnder5MB() && (!isSignedIn() || request.auth.uid == ownerId || isAdmin());
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == ownerId);
    }

    function isCeo() {
      return isSignedIn() &&
        request.auth.token.email == 'stephenaleje61@gmail.com' &&
        request.auth.token.email_verified == true &&
        (!('ceoAdmin' in request.auth.token) || request.auth.token.ceoAdmin == true);
    }

    // LOST AND FOUND item photos
    match /lost_and_found/{ownerId}/{fileName} {
      allow read: if true;
      allow create, update: if isImage() && isUnder5MB() && (!isSignedIn() || request.auth.uid == ownerId || isAdmin());
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == ownerId);
    }

    // OFFICIAL CEO VERIFICATION LOGOS (public read for verified badges; write/delete strictly CEO-only)
    match /ceo_verification_logos/{ownerId}/{fileName} {
      allow read: if true;
      allow create, update: if isCeo() && isImage() && isUnder5MB();
      allow delete: if isCeo();
    }

    // Accommodation photos (National Network)
    match /accommodation/{ownerId}/{fileName} {
      allow read: if true;
      allow create, update: if isSignedIn() && request.auth.uid == ownerId && isImage() && isUnder5MB();
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == ownerId);
    }

    // User profile avatars
    match /avatars/{ownerId}/{fileName} {
      allow read: if true;
      allow create, update: if isSignedIn() && request.auth.uid == ownerId && isImage() && isUnder5MB();
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == ownerId);
    }

    // Campus Food Vendors & Menu Item photos
    match /food/{ownerId}/{fileName} {
      allow read: if true;
      allow create, update: if isSignedIn() && request.auth.uid == ownerId && isImage() && isUnder5MB();
      allow delete: if isAdmin() || isCeo() || (isSignedIn() && request.auth.uid == ownerId);
    }

    // Campus Books & Study Materials photos
    match /books/{ownerId}/{fileName} {
      allow read: if true;
      allow create, update: if isSignedIn() && request.auth.uid == ownerId && isImage() && isUnder5MB();
      allow delete: if isAdmin() || isCeo() || (isSignedIn() && request.auth.uid == ownerId);
    }

    // Student Deals & Giveaways photos
    match /deals/{ownerId}/{fileName} {
      allow read: if true;
      allow create, update: if isSignedIn() && request.auth.uid == ownerId && isImage() && isUnder5MB();
      allow delete: if isAdmin() || isCeo() || (isSignedIn() && request.auth.uid == ownerId);
    }

    // Confidential House Agent KYC verification documents (owner, Admin, CEO read only)
    match /agent_kyc/{ownerId}/{fileName} {
      allow read: if isAdmin() || isCeo() || (isSignedIn() && request.auth.uid == ownerId);
      allow create, update: if isSignedIn() && request.auth.uid == ownerId && isImage() && isUnder5MB();
      allow delete: if isAdmin() || isCeo() || (isSignedIn() && request.auth.uid == ownerId);
    }
  }
}
